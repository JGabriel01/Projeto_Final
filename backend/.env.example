# MySQL connection string para execução via docker-compose
MYSQL_ROOT_PASSWORD=exemplo_root_pwd
MYSQL_DATABASE=biblioteca
MYSQL_USER=biblioteca_user
MYSQL_PASSWORD=biblioteca_pwd

# Connection string usada pelo Prisma (mantém compatibilidade com os valores acima)
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@localhost:3306/${MYSQL_DATABASE}"