// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Notificação
model Notificacao {
  id_notificacao Int     @id @default(autoincrement())
  tipo           String
  mensagem       String
  data_envio     DateTime
  lido           Boolean @default(false)
  acao           String?
  referencia_id  Int?
  
  usuario_id     Int
  usuario        Usuario  @relation(fields: [usuario_id], references: [id_usuario])
  
  id_emprestimo  Int?
  emprestimo     Emprestimo? @relation(fields: [id_emprestimo], references: [id_emprestimo])
}

// Usuário (entidade base com herança)
model Usuario {
  id_usuario Int       @id @default(autoincrement())
  nome       String
  email      String    @unique
  senha      String
  nivel_acesso String    // "aluno", "professor", "admin", "usuario_comum"
  foto_perfil_url String?
  foto_perfil_objeto String?
  fundo_perfil_url String?
  fundo_perfil_objeto String?
  
  notificacoes Notificacao[]
  reservas    Reserva[]
  emprestimos Emprestimo[]
  curtidasLivros CurtidaLivro[]
  solicitacoesExclusaoAdmin SolicitacaoExclusaoAdmin[] @relation("AdminSolicitante")
  
  aluno      Aluno?
  professor  Professor?
  admin      Admin?
}

// Aluno (subtipo de Usuario)
model Aluno {
  usuario_id        Int     @id
  ano_ingresso      Int
  curso             String
  matricula_aluno   String  @unique
  
  usuario    Usuario @relation(fields: [usuario_id], references: [id_usuario], onDelete: Cascade)
}

// Professor (subtipo de Usuario)
model Professor {
  usuario_id Int @id
  departamento      String
  matricula_professor String @unique
  
  usuario    Usuario @relation(fields: [usuario_id], references: [id_usuario], onDelete: Cascade)
}

// Admin (subtipo de Usuario)
model Admin {
  usuario_id Int @id
  cargo    String
  
  usuario    Usuario @relation(fields: [usuario_id], references: [id_usuario], onDelete: Cascade)
}

// Livro
model Livro {
  id_livro       Int    @id @default(autoincrement())
  titulo         String
  autor          String
  genero         String
  ano_publicacao Int
  sinopse        String
  status         String @default("disponível")
  capa_url       String?
  capa_objeto    String?
  
  reservas       Reserva[]
  exemplares     Exemplar[]
  curtidas        CurtidaLivro[]
}

model CurtidaLivro {
  id_curtida   Int      @id @default(autoincrement())
  data_curtida DateTime @default(now())

  usuario_id Int
  usuario    Usuario @relation(fields: [usuario_id], references: [id_usuario], onDelete: Cascade)

  livro_id Int
  livro    Livro @relation(fields: [livro_id], references: [id_livro], onDelete: Cascade)

  @@unique([usuario_id, livro_id])
  @@index([livro_id])
}

// Exemplar
model Exemplar {
  id_exemplar      Int    @id @default(autoincrement())
  codigo_tombo     String @unique
  estado           String
  localizacao      String
  livro_id         Int
  livro            Livro @relation(fields: [livro_id], references: [id_livro], onDelete: Cascade)
  
  multas           Multa[]
  emprestimos      Emprestimo[]

  @@index([livro_id])
}

// Reserva
model Reserva {
  id_reserva     Int      @id @default(autoincrement())
  data_reserva   DateTime @default(now())
  data_expiracao DateTime
  status_reserva String   @default("ativa")
  notificado_em  DateTime?
  
  usuario_id Int
  usuario    Usuario @relation(fields: [usuario_id], references: [id_usuario])
  
  livro_id Int
  livro    Livro @relation(fields: [livro_id], references: [id_livro])
  
  @@index([usuario_id])
  @@index([livro_id])
}

// Empréstimo
model Emprestimo {
  id_emprestimo    Int      @id @default(autoincrement())
  data_saida       DateTime @default(now())
  data_vencimento  DateTime
  data_devolucao_real DateTime?
  renovacoes       Int      @default(0)
  status_extensao  String   @default("nenhuma")
  
  usuario_id Int
  usuario    Usuario @relation(fields: [usuario_id], references: [id_usuario])
  
  exemplar_id Int?
  exemplar    Exemplar? @relation(fields: [exemplar_id], references: [id_exemplar])
  
  notificacoes Notificacao[]
  multa      Multa?
  
  @@index([usuario_id])
  @@index([exemplar_id])
}

// Multa
model Multa {
  id_multa         Int      @id @default(autoincrement())
  valor_multa      Float
  status_pagamento String   @default("pendente")
  data_geracao     DateTime @default(now())
  data_pagamento   DateTime?
  
  emprestimo_id Int @unique
  emprestimo    Emprestimo @relation(fields: [emprestimo_id], references: [id_emprestimo])
  
  exemplar_id Int
  exemplar    Exemplar @relation(fields: [exemplar_id], references: [id_exemplar])
}

model SolicitacaoExclusaoAdmin {
  id_solicitacao Int      @id @default(autoincrement())
  admin_id       Int
  status         String   @default("pendente")
  data_criacao   DateTime @default(now())
  data_decisao   DateTime?
  decidido_por   Int?

  admin          Usuario  @relation("AdminSolicitante", fields: [admin_id], references: [id_usuario], onDelete: Cascade)

  @@index([admin_id])
}


